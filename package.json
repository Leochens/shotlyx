{
	"name": "shotlyx",
	"license": "AGPL-3.0-only",
	"packageManager": "bun@1.2.18",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build:tools": "turbo run build --filter=@shotlyx/tools",
		"build:wasm": "wasm-pack build rust/wasm --target bundler --out-dir pkg",
		"build:web": "turbo run build --filter=@shotlyx/web",
		"build:client": "bun run --cwd apps/client build",
		"dist:client": "bun run --cwd apps/client dist",
		"dist:client:all": "bun run --cwd apps/client dist:all",
		"dist:client:mac": "bun run --cwd apps/client dist:mac",
		"dist:client:mac:unsigned": "bun run --cwd apps/client dist:mac:unsigned",
		"dist:client:win": "bun run --cwd apps/client dist:win",
		"deploy:web": "turbo run deploy --filter=@shotlyx/web",
		"dev:tools": "turbo run dev --filter=@shotlyx/tools",
		"dev:wasm": "cargo watch -w rust/crates -w rust/wasm/src -s 'wasm-pack build rust/wasm --target bundler --out-dir pkg'",
		"dev:web": "turbo run dev --filter=@shotlyx/web",
		"dev:client": "bun run --cwd apps/client dev",
		"format:web": "prettier apps/web/src/services/renderer --write",
		"generate:fonts": "npx tsx apps/web/scripts/generate-font-sprites.ts",
		"lint:web": "eslint apps/web/src --ext .ts,.tsx",
		"lint:web:fix": "eslint apps/web/src --ext .ts,.tsx --fix",
		"preview:web": "turbo run preview --filter=@shotlyx/web",
		"pack:client:unsigned": "bun run --cwd apps/client pack:unsigned",
		"publish:client:mac": "bun run --cwd apps/client publish:mac",
		"publish:client:win": "bun run --cwd apps/client publish:win",
		"publish:wasm": "bun run build:wasm && npm publish rust/wasm/pkg --access public",
		"start:tools": "turbo run start --filter=@shotlyx/tools",
		"start:client": "bun run --cwd apps/client start",
		"test": "bun test eslint/rules apps/web/src",
		"test:e2e:client": "bun run --cwd apps/web test:e2e:desktop"
	},
	"dependencies": {
		"@types/react": "^19.2.10",
		"@types/react-dom": "^19.2.3",
		"better-auth": "^1.4.15",
		"opencut-wasm": "^0.2.10"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.5.0",
		"prettier": "^3.8.3",
		"turbo": "^2.8.20",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.59.0"
	},
	"trustedDependencies": [
		"@tailwindcss/oxide"
	]
}
