# Environment variables example
# Copy this file to .env.local and update the values as needed

# Node
NODE_ENV=development

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARBLE_API_URL=https://api.marblecms.com

# Server
DATABASE_URL="postgresql://shotlyx:shotlyx@localhost:5432/shotlyx"
BETTER_AUTH_SECRET=your_better_auth_secret

UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=example_token

MARBLE_WORKSPACE_KEY=your_workspace_key_here

FREESOUND_CLIENT_ID=your_client_id_here

# Agent LLM
#
# AGENT_LLM_* controls the default chat/tool-calling model.
#
# Supported providers:
# - openai: official OpenAI API, default host is https://api.openai.com/v1
# - openai-compatible: OpenAI-compatible proxy or third-party gateway
# - google: native Gemini API, default host is https://generativelanguage.googleapis.com/v1beta
# - anthropic: native Claude API, default host is https://api.anthropic.com/v1
#
# Structured output modes:
# - auto: use the safest default for each provider
# - native: force AI SDK structured output / response schema
# - plain-json: ask the model for JSON text, then validate locally
#
# Use plain-json for Gemini when the schema contains unsupported JSON Schema fields
# such as exclusiveMinimum or additionalProperties.
AGENT_LLM_PROVIDER=openai
AGENT_LLM_KEY=your_openai_api_key_here
AGENT_LLM_MODEL=gpt-4o
# AGENT_LLM_HOST=https://api.openai.com/v1  # optional: custom base URL
# AGENT_LLM_STRUCTURED_OUTPUT_MODE=auto

# Shotlyx MG / Remotion generation
#
# AGENT_MG_* controls the model used for generating Remotion MG components.
# If any AGENT_MG_* value is omitted, it falls back to AGENT_LLM_*.
# Recommended: use a stronger visual/code model here than the default chat model.
#
# Example A: OpenAI for MG
# AGENT_MG_PROVIDER=openai
# AGENT_MG_KEY=your_openai_api_key_here
# AGENT_MG_MODEL=gpt-4o
# AGENT_MG_HOST=https://api.openai.com/v1
# AGENT_MG_STRUCTURED_OUTPUT_MODE=auto
#
# Example B: OpenAI-compatible proxy for MG
# AGENT_MG_PROVIDER=openai-compatible
# AGENT_MG_KEY=your_proxy_api_key_here
# AGENT_MG_MODEL=your-model-name
# AGENT_MG_HOST=https://your-proxy.example.com/v1
# AGENT_MG_STRUCTURED_OUTPUT_MODE=auto
#
# Example C: Gemini for MG
# Gemini's native response_schema rejects some JSON Schema keywords that Zod/AI SDK
# may emit, so plain-json is the safest mode for now.
# AGENT_MG_PROVIDER=google
# AGENT_MG_KEY=your_google_api_key_here
# AGENT_MG_MODEL=gemini-2.5-flash
# AGENT_MG_STRUCTURED_OUTPUT_MODE=plain-json
#
# Example D: Claude for MG
# AGENT_MG_PROVIDER=anthropic
# AGENT_MG_KEY=your_anthropic_api_key_here
# AGENT_MG_MODEL=claude-sonnet-4-5
# AGENT_MG_STRUCTURED_OUTPUT_MODE=plain-json

# Agent image generation (OpenAI-compatible)
IMAGE_GENERATION_BASE_URL=https://api.openai.com/v1
IMAGE_GENERATION_API_KEY=your_image_generation_api_key_here
IMAGE_GENERATION_MODEL=gpt-image-1
IMAGE_GENERATION_RESPONSE_FORMAT=url

# Agent Seedance video generation (Volcengine Ark)
#
# Create the API key in Volcengine Ark API Key management, then enable the
# Seedance video model in the same Ark project space. The browser calls the
# local server route, so this key must never use NEXT_PUBLIC_.
# VOLCENGINE_ARK_API_KEY=your_volcengine_ark_api_key_here
# VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# SEEDANCE_VIDEO_MODEL=doubao-seedance-1-5-pro-251215

# Agent voiceover / TTS
#
# Pure JS path: call an OpenAI-compatible speech API over fetch.
# No Python or local CLI dependency is required.
# TTS_GENERATION_BASE_URL may point to OpenAI or an OpenAI-compatible proxy.
VOICEOVER_PROVIDER=openai
TTS_GENERATION_BASE_URL=https://api.openai.com/v1
TTS_GENERATION_API_KEY=your_tts_api_key_here
TTS_GENERATION_MODEL=gpt-4o-mini-tts
TTS_GENERATION_VOICE=alloy
#
# Optional no-key Node Edge TTS path. Uses the node-edge-tts npm package.
# VOICEOVER_PROVIDER=edge-tts
# EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# EDGE_TTS_LANG=zh-CN
# EDGE_TTS_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3
# EDGE_TTS_RATE=default
# EDGE_TTS_PITCH=default
# EDGE_TTS_VOLUME=default
# EDGE_TTS_TIMEOUT_MS=60000  # increase if node-edge-tts often reports Timed out
# EDGE_TTS_PROXY=http://localhost:7890
#
# Optional Volcengine/Doubao TTS path. This uses the V3 HTTP Chunked endpoint
# and supports both preset voices and cloned SpeakerID voices.
# VOICEOVER_PROVIDER=volcengine
# VOLCENGINE_TTS_API_KEY=your_volcengine_new_console_tts_api_key_here
# You can also reuse a shared VOLCENGINE_API_KEY or VOLCENGINE_ASR_API_KEY if
# that key has TTS permissions enabled in the Doubao Speech console.
# VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
# VOLCENGINE_TTS_CLONE_RESOURCE_ID=seed-icl-2.0
# VOLCENGINE_TTS_DEFAULT_SPEAKER=zh_female_xiaohe_uranus_bigtts
# VOLCENGINE_TTS_SAMPLE_RATE=24000
# VOLCENGINE_TTS_UID=shotlyx
# VOLCENGINE_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
#
# Optional cloned voices visible to both the UI and Agent voiceover_list_voices.
# VOLCENGINE_TTS_CLONED_VOICES=[{"id":"my-voice","name":"My Voice","speaker":"S_xxxxxxxx","resourceId":"seed-icl-2.0"}]
#
# Optional AK/SK for live voice catalog and cloned SpeakerID status APIs.
# VOLCENGINE_ACCESS_KEY_ID=your_volcengine_access_key_id_here
# VOLCENGINE_SECRET_ACCESS_KEY=your_volcengine_secret_access_key_here
# VOLCENGINE_TTS_APP_ID=your_volcengine_tts_app_id_here
# VOLCENGINE_TTS_ACCESS_KEY=your_legacy_volcengine_tts_access_token_here

# Agent transcription / ASR
#
# subtitles_generate_from_video defaults to Volcengine/Doubao ASR through the
# server-side Node route, so the API key stays out of the browser bundle.
#
# Supported provider IDs:
# - volcengine: Volcengine/Doubao bigmodel flash ASR
# - local: local browser Whisper fallback
# - openai-compatible: Whisper-compatible /audio/transcriptions endpoint
#
# Reserved provider IDs for later vendor adapters:
# - tencent: Tencent Cloud ASR
# - aliyun: Alibaba Cloud NLS
# - baidu: Baidu Cloud Speech
# - iflytek: iFlytek ASR
#
# Example A: Volcengine/Doubao ASR with the new console API Key
ASR_PROVIDER=volcengine
VOLCENGINE_ASR_API_KEY=your_volcengine_new_console_api_key_here
# VOLCENGINE_ASR_UID=shotlyx
# VOLCENGINE_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
# VOLCENGINE_ASR_FLASH_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
# ASR_MODEL=bigmodel
#
# Example B: OpenAI-compatible ASR endpoint
# ASR_PROVIDER=openai-compatible
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_API_KEY=your_asr_api_key_here
# ASR_MODEL=whisper-1
#
# Example C: Tencent placeholder. Fill these after the provider adapter is added.
# ASR_PROVIDER=tencent
# ASR_API_KEY=your_tencent_secret_id_or_token_here
# ASR_SECRET_KEY=your_tencent_secret_key_here
# ASR_MODEL=16k_zh

# Agent stock media search
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here
FREESOUND_API_KEY=your_freesound_api_key_here

# Agent web search / page fetch
#
# Search providers:
# - tavily: general-purpose agent web search. Requires TAVILY_API_KEY.
# - firecrawl: search plus optional scraping. Requires FIRECRAWL_API_KEY.
# - brave: independent web index. Requires BRAVE_SEARCH_API_KEY.
AGENT_WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here
# FIRECRAWL_API_KEY=your_firecrawl_api_key_here
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
#
# Fetch providers:
# - jina: lightweight URL to LLM-readable text. JINA_API_KEY is optional but raises limits.
# - firecrawl: stronger scrape for dynamic pages/PDFs. Requires FIRECRAWL_API_KEY.
AGENT_WEB_FETCH_PROVIDER=jina
# JINA_API_KEY=your_jina_api_key_here
