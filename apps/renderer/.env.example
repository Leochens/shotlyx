# Shotlyx Desktop is fully usable without provider credentials.
# Configure optional providers inside the app. This file is only for local
# development overrides.

SHOTLYX_DESKTOP=1
VITE_SHOTLYX_DESKTOP=1
VITE_SHOTLYX_API_ORIGIN=app://shotlyx

# Optional stock audio search.
FREESOUND_API_KEY=

# Optional development diagnostics. Keep disabled by default.
VITE_REACT_SCAN=false
