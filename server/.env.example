# Shotlyx Server
PORT=8787

# Required when NODE_ENV=production.
SHOTLYX_ADMIN_TOKEN=replace_with_admin_console_token

# Persistence. Required when NODE_ENV=production.
# Without DATABASE_URL in development/test, the server falls back to the
# in-memory store for quick local experiments.
DATABASE_URL=postgresql://shotlyx:shotlyx@127.0.0.1:5432/shotlyx

# New API gateway. When both values are present, Shotlyx Server provisions
# users through New API's /api/user/ and /api/token/ management APIs.
SHOTLYX_NEW_API_BASE_URL=https://your-new-api.example.com
SHOTLYX_NEW_API_ADMIN_TOKEN=replace_with_new_api_admin_token
SHOTLYX_NEW_API_DEFAULT_GROUP=default
SHOTLYX_INITIAL_QUOTA=100000

# ZPAY self-service recharge. `SHOTLYX_SERVER_PUBLIC_URL` must be the public
# HTTPS origin that ZPAY can call for /api/callbacks/zpay.
SHOTLYX_ZPAY_PID=replace_with_zpay_pid
SHOTLYX_ZPAY_KEY=replace_with_zpay_key
SHOTLYX_ZPAY_SUBMIT_URL=https://zpayz.cn/submit.php
SHOTLYX_SERVER_PUBLIC_URL=https://api.your-shotlyx.example.com
SHOTLYX_CREDITS_PER_CNY=10000

# Billing Center reference integration. Current Shotlyx Server keeps the ZPAY
# checkout adapter active and exposes this status in /admin for cutover checks.
BILLING_CENTER_BASE_URL=https://pay.guantou.site
BILLING_CENTER_API_KEY=replace_with_billing_center_api_key
BILLING_CENTER_APP_CODE=shotlyx

# Product usage pricing. Override these in production when the admin backend
# changes the credit model.
USAGE_CREDITS_ASR_TRANSCRIPTION_MINUTE=1200
USAGE_CREDITS_LLM_AGENT_TURN=800
USAGE_CREDITS_VOICEOVER_1K_CHARS=2000
USAGE_CREDITS_IMAGE_GENERATION=5000
USAGE_CREDITS_MG_GENERATION=8000
USAGE_CREDITS_STOCK_IMPORT=500

# Object storage. Use `local` for development; use cos/r2/s3 for web production.
STORAGE_DRIVER=local
STORAGE_KEY_PREFIX=shotlyx
STORAGE_MAX_UPLOAD_SIZE_MB=512
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
#
# Tencent COS
# COS_REGION=ap-guangzhou
# COS_BUCKET=shotlyx-assets
# COS_SECRET_ID=replace_with_cos_secret_id
# COS_SECRET_KEY=replace_with_cos_secret_key
# COS_PUBLIC_BASE_URL=https://assets.your-shotlyx.example.com
#
# Cloudflare R2
# R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
# R2_BUCKET=shotlyx-assets
# R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
# R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
# R2_PUBLIC_BASE_URL=https://assets.your-shotlyx.example.com
#
# S3-compatible
# S3_ENDPOINT=https://s3.your-provider.example.com
# S3_BUCKET=shotlyx-assets
# S3_ACCESS_KEY_ID=replace_with_s3_access_key_id
# S3_SECRET_ACCESS_KEY=replace_with_s3_secret_access_key
# S3_PUBLIC_BASE_URL=https://assets.your-shotlyx.example.com
