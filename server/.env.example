# Shotlyx Server
PORT=8787

# Required when NODE_ENV=production.
SHOTLYX_ADMIN_TOKEN=replace_with_admin_console_token

# Persistence. Required when NODE_ENV=production.
# Without DATABASE_URL in development/test, the server falls back to the
# in-memory store for quick local experiments.
DATABASE_URL=postgresql://shotlyx:shotlyx@127.0.0.1:5432/shotlyx

# New API gateway. When both values are present, Shotlyx Server provisions
# users through New API's /api/user/ and /api/token/ management APIs.
SHOTLYX_NEW_API_BASE_URL=https://your-new-api.example.com
SHOTLYX_NEW_API_ADMIN_TOKEN=replace_with_new_api_admin_token
SHOTLYX_NEW_API_DEFAULT_GROUP=default
SHOTLYX_INITIAL_QUOTA=100000

# ZPAY self-service recharge. `SHOTLYX_SERVER_PUBLIC_URL` must be the public
# HTTPS origin that ZPAY can call for /api/callbacks/zpay.
SHOTLYX_ZPAY_PID=replace_with_zpay_pid
SHOTLYX_ZPAY_KEY=replace_with_zpay_key
SHOTLYX_ZPAY_SUBMIT_URL=https://zpayz.cn/submit.php
SHOTLYX_SERVER_PUBLIC_URL=https://api.your-shotlyx.example.com
SHOTLYX_CREDITS_PER_CNY=10000
